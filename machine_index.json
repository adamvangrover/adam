      { "name": "Sector Swarm Roundtable", "path": "sector_swarm.html" },
      { "name": "Wargame Console", "path": "wargame_dashboard.html" },
      { "name": "Agent Gallery", "path": "agent_gallery.html" },
      { "name": "Neural Link Convergence", "path": "adam_convergence_live_neural_link.html", "status": "new" },
      { "name": "Nexus Simulation", "path": "nexus.html" }
    ],
    "developer_tools": [
      { "name": "System Brain (Knowledge Graph)", "path": "system_brain.html" },
      { "name": "Quantum Infrastructure", "path": "quantum_infrastructure.html" },
      { "name": "Prompt Library & Alpha", "path": "apps/prompt_alpha.html" },
      { "name": "Creator Studio", "path": "editor_studio.html" },
      { "name": "Scenario Lab (VAE)", "path": "scenario_lab.html" },
      { "name": "AVG Search Engine", "path": "avg_search.html" }
