  "showcase_statistics": {
    "total_html_artifacts": 528,
    "daily_briefings": 100,
    "market_pulses": 70,
    "house_views": 14,
    "market_mayhem_editions": 30,
    "company_reports": 15,
    "deep_dives": 8,
    "counterfactual_scenarios": 5
  },
  "governance": {
    "provenance_standard": "W3C PROV-O",
    "rules_engine": "JSONLogic",
    "minimum_conviction_threshold": 0.85,
    "break_glass_protocol": "HMAC-SHA256 signed X-Governance-Override header",
    "security_mandates": ["No pickle.load()", "No dynamic imports", "No eval/exec", "Input sanitization required"]
  },
  "benchmarks": {
    "financebench_accuracy": "99%",
    "pricing_engine_latency": "<5ms",
    "filing_ingestion_time": "<12 seconds",
    "deterministic_drift": "0%"
