{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ADAM Financial Operating System",
  "acronym": "AFOS",
  "version": "30.1",
  "license": "MIT",
  "repository": "https://github.com/adamvangrover/adam",
  "homepage": "https://adamvangrover.github.io/adam/",
  "description": "Institutional-grade neuro-symbolic multi-agent financial operating system for credit risk, market intelligence, and portfolio surveillance.",
  "domain": "Institutional Credit Risk & Market Intelligence",
  "architecture": "Hybrid Cognitive Engine (System 1 Swarm + System 2 Neuro-Symbolic DAG)",
  "last_updated": "2026-08-22T00:00:00Z",
  "tech_stack": {
    "deterministic_execution": "Rust",
    "orchestration": "Python 3.11+",
    "type_safety": "Pydantic",
    "governance": "JSONLogic / YAML",
    "frontend": "HTML / React / Three.js",
    "knowledge_representation": "GNN / FIBO Ontology",
    "vector_search": "Qdrant",
    "package_manager": "uv",
    "containerization": "Docker / Docker Compose"
