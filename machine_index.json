  "entry_points": {
    "human": {
      "web_portal": "index.html",
      "analyst_os": "showcase/dashboards/analyst_os.html",
      "neural_dashboard": "showcase/index.html",
      "command_center": "portal/index.html",
      "daily_reports": "showcase/dashboards/adam_daily_hub_index.html",
      "documentation": "docs/index.html"
