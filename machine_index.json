  "entry_points": {
    "human": {
      "web_portal": "index.html",
      "analyst_os": "analyst_os.html",
      "neural_dashboard": "showcase/index.html",
      "command_center": "portal/index.html",
      "daily_reports": "adam_daily_hub_index.html",
      "documentation": "docs/index.html"
    },
    "machine": {
      "llm_context_optimized": "llms.txt",
      "llm_context_full": "llms-full.txt",
      "llm_readme": "LLM_README.md",
      "agent_bible": "AGENTS.md",
      "agent_catalog": "AGENT_CATALOG.md",
      "api_schema": "api_schema.yaml",
      "this_manifest": "machine_index.json"
    }
  },
  "cognitive_systems": {
    "system_1": {
      "name": "Neural Swarm (HiveMind)",
      "role": "Fast perception, reflexes, asynchronous surveillance",
      "architecture": "Event-driven Pub/Sub",
      "base_class": "AsyncAgentBase",
      "latency": "<12 seconds for full 10-K ingestion",
      "locations": ["core/system/", "adam_swarm/"]
    },
    "system_2": {
      "name": "Neuro-Symbolic Graph (Planner)",
      "role": "Deep reasoning, credit underwriting, scenario analysis",
      "architecture": "Directed Acyclic Graph (DAG) state machine",
      "base_class": "TemplateAgentV30",
      "locations": ["core/engine/", "core/agents/"]
    }
  },
  "agent_registry": {
    "core_agents": [
      { "name": "Nexus (Orchestrator)", "role": "Workflow runtime, task dispatch", "location": "core/engine/orchestrator.py" },
      { "name": "Underwriting Agent", "role": "Credit analysis, capital structures", "sector": "TMT / Leveraged Finance" },
      { "name": "Surveillance Agent", "role": "Portfolio monitoring, threat telemetry" },
      { "name": "Sentinel Agent", "role": "Security, PROV-O compliance audits" },
      { "name": "Architect Agent (Jules)", "role": "Repository architecture, refactoring" }
    ],
    "specialized_agents": {
      "risk_credit": ["CreditRiskAgent", "SNCAnalystAgent", "CovenantAgent", "LiquidityRiskAgent"],
      "quantitative_market": ["AlgoTradingAgent", "OptionsFlowAgent", "QuantumPortfolioManagerAgent", "MarketMakingAgent"],
      "macro_altdata": ["BlackSwanAgent", "MacroeconomicAnalysisAgent", "GeopoliticalRiskAgent", "AlternativeDataAgent"],
      "governance_security": ["RedTeamAgent", "ComplianceAgent", "DataVerificationAgent", "FraudDetectionAgent"]
    },
    "full_catalog": "AGENT_CATALOG.md"
  },
  "modules": {
    "core_workspaces": [
