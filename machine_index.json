      { "name": "Market Mayhem Terminal", "path": "showcase/market_mayhem_v26.html", "status": "active" },
      { "name": "Neural Dashboard", "path": "showcase/neural_dashboard.html", "status": "static" },
      { "name": "Repository Codex", "path": "showcase/codex.html", "status": "active" }
