  "io_schemas": {
    "agent_input": {
      "fields": [
        "query (str)",
        "context (Dict)",
        "tools (List[str])"
      ],
      "validation": "Pydantic BaseModel"
    },
    "agent_output": {
      "fields": [
        "answer (str)",
        "sources (List[str])",
        "confidence (float 0.0-1.0)",
        "metadata (Dict)",
        "prov_o_audit_trail (List[Dict])"
