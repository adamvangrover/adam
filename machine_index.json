    "financial_modeling": [
      { "name": "Credit & Valuation Architect", "path": "credit_valuation_architect.html" },
      { "name": "Monte Carlo Risk Engine", "path": "monte_carlo_visualizer.html" },
      { "name": "Comprehensive Credit Dashboard", "path": "comprehensive_credit_dashboard.html" },
      { "name": "Institutional Radar (13F)", "path": "institutional_radar.html" },
