    "code": {
      "orchestrator": "core/engine/meta_orchestrator.py::MetaOrchestrator.route_request",
      "agent_base": "core/agents/agent_base.py::AgentBase.execute",
      "agent_io_schema": "core/schemas/agent_schema.py",
      "web_api": "services/webapp/api.py::create_app",
      "mcp_server": "server/server.py",
      "v30_orchestrator": "core/v30_architecture/python_intelligence/orchestrator/v30_orchestrator.py"
    }
  },
  "cognitive_systems": {
    "system_1": {
      "name": "Neural Swarm (HiveMind)",
      "role": "Fast perception, reflexes, asynchronous surveillance",
      "architecture": "Event-driven Pub/Sub",
      "base_class": "AsyncAgentBase",
      "latency": "<12 seconds for full 10-K ingestion",
      "locations": [
        "core/system/",
        "adam_swarm/"
      ]
    },
    "system_2": {
      "name": "Neuro-Symbolic Graph (Planner)",
      "role": "Deep reasoning, credit underwriting, scenario analysis",
      "architecture": "Directed Acyclic Graph (DAG) state machine",
      "base_class": "TemplateAgentV30",
      "locations": [
        "core/engine/",
        "core/agents/"
      ]
    }
  },
  "agent_registry": {
    "core_agents": [
      {
        "name": "Nexus (Orchestrator)",
