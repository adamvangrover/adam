{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Tool Capability",
  "type": "object",
  "properties": {
    "capability_id": { "type": "string" },
    "risk_class": { "type": "string" },
    "actor": { "type": "string" },
    "scope": { "type": "string" },
    "required_approval": { "type": "boolean" },
    "maximum_transaction_value": { "type": "number" },
    "allowed_resources": { "type": "array", "items": { "type": "string" } },
    "policy_bundle": { "type": "string" },
    "provenance_required": { "type": "boolean" },
    "expiration": { "type": "integer" },
    "idempotency_requirement": { "type": "boolean" }
  },
  "required": ["capability_id", "risk_class", "policy_bundle"]
}
