{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Frozen Context",
  "type": "object",
  "properties": {
    "context_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_ids": { "type": "array", "items": { "type": "string" } },
    "document_hashes": { "type": "array", "items": { "type": "string" } },
    "market_snapshot_id": { "type": "string" },
    "portfolio_snapshot_id": { "type": "string" },
    "policy_version": { "type": "string" },
    "model_version": { "type": "string" },
    "code_revision": { "type": "string" },
    "retrieval_manifest": { "type": "object" },
    "feature_manifest": { "type": "object" },
    "expires_at": { "type": "string", "format": "date-time" },
    "context_hash": { "type": "string" }
  },
  "required": ["context_id", "created_at", "context_hash"]
}
