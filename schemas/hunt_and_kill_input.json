{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HuntAndKillInputSchema",
  "type": "object",
  "required": [
    "targets",
    "counter_predation_inputs"
  ],
  "properties": {
    "correlation_id": { "type": "string" },
    "sofr_base_rate_pct": { "type": "number", "default": 5.25 },
    "hurdle_rate_bps": { "type": "number", "default": 150.0 },
    "targets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "counter_predation_inputs": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
