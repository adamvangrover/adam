{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarketMayhemLedger",
  "type": "object",
  "properties": {
    "variable_node": {
      "type": "string",
      "description": "UUID of the variable in the Adam OS Graph."
    },
    "market_level_value": {
      "type": "number",
      "description": "The observed or simulated market value."
    },
    "primary_model_target": {
      "type": "string",
      "enum": ["PD", "LGD", "DCF", "EV", "WACC"],
      "description": "The targeted financial metric."
    },
    "context_provenance": {
      "type": "string",
      "description": "Hash or ID linking to the provenance trace."
    }
  },
  "required": ["variable_node", "market_level_value", "primary_model_target", "context_provenance"]
}