<!DOCTYPE html>
<html lang="en" data-adam-role="report" data-adam-family="{{ e.family }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ family_label }} — {{ e.title }} ({{ e.date.isoformat() }})</title>
<meta name="adam-edition" content="{{ e.edition_id }}">
<link rel="stylesheet" href="{{ kit_href }}/adam-publication.css">
<!-- adam-kit -->
<link rel="stylesheet" href="{{ kit_href }}/adam-kit.css">
<script src="{{ kit_href }}/adam-kit.js"></script>
<!-- /adam-kit -->
<script src="{{ kit_href }}/adam-publication.js" defer></script>
</head>
<body class="adam-pub adam-pub--{{ e.family }}">
<main class="adam-pub__page">
{% if e.estimated %}
<p class="adam-pub__label" role="note" data-adam-hook="estimated-label">{{ estimated_label }}. Figures marked * are synthetic (<code>_estimated: true</code>) per docs/PROVENANCE.md.</p>
{% endif %}
<header class="adam-pub__masthead" data-adam-hook="masthead">
  <p class="adam-pub__kicker">{% block kicker %}{{ family_label }}{% endblock %} · {{ e.date.isoformat() }}</p>
  <h1>{{ e.title }}</h1>
  {% if e.summary %}<p class="adam-pub__summary">{{ e.summary }}</p>{% endif %}
</header>
{% block before_sections %}{% endblock %}
{% if e.market_snapshot %}
<section class="adam-pub__panel" data-adam-hook="market-snapshot">
  <h2>{% block snapshot_title %}Market snapshot{% endblock %}</h2>
  <table class="adam-pub__table"><thead><tr><th>Instrument</th><th>Level</th><th>Change</th></tr></thead><tbody>
  {% for s in e.market_snapshot %}
    <tr><td>{{ s.name }}{% if s.estimated %}*{% endif %}</td><td>{{ s.value|num }} {{ s.unit }}</td><td>{% if s.change is not none %}{{ "%+.2f"|format(s.change) }} {{ s.change_unit }}{% else %}—{% endif %}</td></tr>
  {% endfor %}
  </tbody></table>
</section>
{% endif %}
{% for s in e.sections %}
<section class="adam-pub__section" data-adam-hook="{{ s.hook }}">
  <h2>{{ s.title }}</h2>
  {% for para in s.body.split("\n\n") if para %}<p>{{ para }}</p>{% endfor %}
  {% if s.bullets %}<ul>{% for b in s.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
</section>
{% endfor %}
{% block after_sections %}{% endblock %}
{% if e.calls %}
<section class="adam-pub__panel" data-adam-hook="calls">
  <h2>{% block calls_title %}Calls{% endblock %}</h2>
  <table class="adam-pub__table"><thead><tr><th>Subject</th><th>Stance</th><th>Conviction</th><th>Rationale</th></tr></thead><tbody>
  {% for c in e.calls %}<tr><td>{{ c.subject }}{% if c.estimated %}*{% endif %}</td><td class="adam-pub__stance adam-pub__stance--{{ c.stance }}">{{ c.stance }}</td><td>{{ "%.0f"|format(c.conviction * 100) }}%</td><td>{{ c.rationale }}</td></tr>{% endfor %}
  </tbody></table>
</section>
{% endif %}
{% if e.price_targets %}
<section class="adam-pub__panel" data-adam-hook="price-targets">
  <h2>Price targets</h2>
  <table class="adam-pub__table"><thead><tr><th>Ticker</th><th>Method</th><th>Horizon</th><th>Bear</th><th>Base</th><th>Bull</th><th>Weighted</th><th>Inputs</th></tr></thead><tbody>
  {% for t in e.price_targets %}<tr><td>{{ t.ticker }}{% if t.estimated %}*{% endif %}</td><td>{{ t.method }}</td><td>{{ t.horizon_months }}m</td><td>{{ t.bear|num }}</td><td>{{ t.base|num }}</td><td>{{ t.bull|num }}</td><td>{{ t.weighted|num }}</td><td><code>{{ t.inputs_ref }}</code></td></tr>{% endfor %}
  </tbody></table>
</section>
{% endif %}
{% if e.scenarios %}
<section class="adam-pub__panel" data-adam-hook="scenarios">
  <h2>Scenarios</h2>
  <div class="adam-pub__grid">
  {% for sc in e.scenarios %}<article class="adam-pub__card adam-pub__card--{{ sc.name }}" data-adam-hook="scenario-{{ sc.name }}"><h3>{{ sc.name|title }} · {{ "%.0f"|format(sc.probability * 100) }}%{% if sc.estimated %}*{% endif %}</h3><p>{{ sc.narrative }}</p>{% if sc.targets %}<ul>{% for k, v in sc.targets.items() %}<li>{{ k }}: {{ v|num }}</li>{% endfor %}</ul>{% endif %}</article>{% endfor %}
  </div>
</section>
{% endif %}
{% if e.risks %}
<section class="adam-pub__panel" data-adam-hook="risks">
  <h2>Risk register</h2>
  <ul class="adam-pub__risks">{% for r in e.risks %}<li><strong>{{ r.name }}</strong>{% if r.estimated %}*{% endif %} — p={{ "%.0f"|format(r.probability * 100) }}%, impact {{ r.impact }}{% if r.description %}: {{ r.description }}{% endif %}</li>{% endfor %}</ul>
</section>
{% endif %}
{% block review %}
{% if e.review %}
{% set rv = e.review %}
<section class="adam-pub__panel" data-adam-hook="review-panel">
  <h2>Bull vs. Bear vs. Red Team</h2>
  <p class="adam-pub__summary" data-adam-hook="review-scores">Judge {{ "%.2f"|format(rv.get("score", 0)) }} ({{ rv.get("judge", {}).get("verdict", "—") }}) · desk verdict {{ rv.get("desk", {}).get("verdict", "—") }} · red-team impact {{ rv.get("red_team", {}).get("impact_score", "—") }} · {{ rv.get("mode", "offline") }} review</p>
  <div class="adam-pub__grid">
  {% for side in ("bull", "bear") %}
    {% set card = rv.get("panel", {}).get(side, {}) %}
    <article class="adam-pub__card adam-pub__card--{{ side }}" data-adam-hook="review-{{ side }}">
      <h3>{{ side|title }}</h3>
      <p>{{ card.get("narrative") or "No " ~ side ~ " scenario in this edition." }}</p>
      {% if card.get("targets") %}<ul>{% for k, v in card.get("targets").items() %}<li>{{ k }}: {{ v|num }}</li>{% endfor %}</ul>{% endif %}
      {% if card.get("price_targets") %}<ul>{% for k, v in card.get("price_targets").items() %}<li>{{ k }} {{ v|num }}</li>{% endfor %}</ul>{% endif %}
    </article>
  {% endfor %}
    {% set red = rv.get("panel", {}).get("red_team", {}) %}
    <article class="adam-pub__card adam-pub__card--red_team" data-adam-hook="review-red-team">
      <h3>Red Team</h3>
      <p>{{ red.get("summary", "") }}</p>
      {% if red.get("challenges") %}<ul>{% for c in red.get("challenges") %}<li>{{ c }}</li>{% endfor %}</ul>{% else %}<p>No challenges raised.</p>{% endif %}
    </article>
  </div>
  {% if rv.get("flags") %}
  <h3>Review flags</h3>
  <ul data-adam-hook="review-flags">{% for f in rv.get("flags") %}<li><strong>{{ f.severity }}</strong> {{ f.code }} ({{ f.hook }}): {{ f.message }}</li>{% endfor %}</ul>
  {% endif %}
</section>
{% endif %}
{% endblock %}
<footer class="adam-pub__footer" data-adam-hook="provenance">
  <h2>Sources &amp; provenance</h2>
  {% if e.sources %}<ul>{% for s in e.sources %}<li>{{ s.label }} — <code>{{ s.ref }}</code>{% if s.as_of %} (as of {{ s.as_of }}){% endif %}</li>{% endfor %}</ul>{% else %}<p>No sources cited.</p>{% endif %}
  <ul>{% for p in e.provenance_trace %}<li><code>{{ p.generator }}</code> v{{ p.version }} · {{ p.timestamp }}{% if p.inputs %} · inputs: {{ p.inputs|join(", ") }}{% endif %}</li>{% endfor %}</ul>
  <p>Schema {{ e.schema_version }} · edition <code>{{ e.edition_id }}</code>. Toggle the machine view with Alt+J or <code>?view=json</code>.</p>
</footer>
</main>
<script id="adam-operator-data" type="application/json">{{ record|tojson }}</script>
</body>
</html>
