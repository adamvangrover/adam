<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="generator" content="scripts/build_dashboard_manifest.py">
<title>ADAM :: __TITLE__</title>
<style>
:root{--bg:#050b14;--panel:#0b1422;--panel2:#0f1a2b;--line:#1f2d40;--text:#e0e6ee;--muted:#8a96a8;--accent:#00f3ff;--ok:#0aff60;color-scheme:dark}
*{box-sizing:border-box}html,body{margin:0}body{background:var(--bg);color:var(--text);font:14px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:var(--accent)}code{font:12px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted)}
header{position:sticky;top:0;z-index:5;display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;padding:14px 24px;background:rgba(5,11,20,.94);backdrop-filter:blur(6px);border-bottom:1px solid var(--line)}
h1{margin:0;font-size:17px;letter-spacing:.04em;color:var(--accent)}h1 span{color:var(--muted);font-weight:400}
.stats{display:flex;gap:18px;color:var(--muted);font-size:12px}.stats b{display:block;color:var(--text);font-size:16px}
.search{flex:1;display:flex;gap:8px;min-width:260px}
input,select,button{background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:6px;padding:7px 10px;font:inherit}
input{flex:1}button{cursor:pointer}button[aria-pressed=true]{border-color:var(--accent);color:var(--accent);background:var(--panel2)}
input:focus,select:focus,button:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.layout{display:grid;grid-template-columns:230px 1fr;min-height:calc(100vh - 70px)}
nav{border-right:1px solid var(--line);padding:16px 12px;position:sticky;top:70px;align-self:start;max-height:calc(100vh - 70px);overflow:auto}
nav h2,main h2{margin:0 0 8px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
nav button{display:flex;justify-content:space-between;width:100%;margin:2px 0;border-color:transparent;background:none;text-align:left}
nav button i{font-style:normal;color:var(--muted)}nav button::before{content:"";width:8px;height:8px;border-radius:2px;margin:6px 8px 0 0;background:var(--c,var(--muted));flex:none}
nav .grow{flex:1}main{padding:16px 24px 48px;min-width:0}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}.chips span{color:var(--muted);font-size:12px;align-self:center;margin-right:4px}
.latest{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;margin-bottom:22px}
.grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:10px}
.card{position:relative;display:flex;flex-direction:column;gap:4px;height:100%;padding:12px 14px 12px 16px;background:var(--panel);border:1px solid var(--line);border-radius:8px;color:inherit;text-decoration:none;overflow-wrap:anywhere}
.card::before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:3px;border-radius:2px;background:var(--c,var(--muted))}
a.card:hover,a.card:focus{border-color:var(--accent);outline:none;transform:translateY(-1px)}
.t{font-weight:600}.m{display:flex;flex-wrap:wrap;gap:6px;color:var(--muted);font-size:12px}
.tag{padding:0 6px;border:1px solid var(--line);border-radius:10px}.date{color:var(--ok)}
.row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto}
.copy{padding:2px 8px;font-size:11px}.empty{color:var(--muted);padding:24px 0}
#count{color:var(--muted);font-size:12px;margin:0 0 10px}
@media (max-width:800px){.layout{grid-template-columns:1fr}nav{position:static;max-height:none;border-right:0;border-bottom:1px solid var(--line)}}
</style>
</head>
<body>
<header>
<h1>ADAM <span>__TITLE__</span></h1>
<div class="stats" id="stats"></div>
<div class="search"><input id="q" type="search" placeholder="Search titles and files  ( / )" aria-label="Search pages">
<select id="sort" aria-label="Sort"><option value="new">Newest edition</option><option value="old">Oldest edition</option><option value="az">Title A–Z</option></select></div>
</header>
<div class="layout">
<nav aria-label="Template families"><h2>Families</h2><div id="fam"></div>
<p><code>Starting templates — pick one, refine to taste. Read <a href="manifest.json">manifest.json</a>.</code></p></nav>
<main>
<section id="latestWrap"><h2>Latest editions</h2><div class="latest" id="latest"></div></section>
<div class="chips" id="kind" role="toolbar" aria-label="Page kind"><span>Kind</span></div>
<div class="chips" id="section" role="toolbar" aria-label="Section"><span>Section</span></div>
<p id="count" aria-live="polite"></p>
<ul class="grid" id="list"></ul>
</main>
</div>
<script type="application/json" id="manifest" data-root="__ROOT__">__MANIFEST__</script>
<script>
const data=JSON.parse(document.getElementById('manifest').textContent),pages=data.dashboards;
const COLORS={market_mayhem:'#ff4d6d',daily_briefing:'#ffb703',market_pulse:'#06d6a0',house_view:'#8ecae6',newsletter:'#f4a261',afos:'#b388ff',adam_os:'#00f3ff',credit:'#e76f51',scenario:'#ef476f',research:'#90be6d',eval_governance:'#c77dff',agents:'#4cc9f0',operations:'#f9c74f',hub:'#adb5bd',other:'#6c757d'};
const EDITIONS=['market_mayhem','daily_briefing','market_pulse','house_view','newsletter'];
const label=s=>s.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase()).replace('Adam Os','Adam OS').replace('Afos','AFOS');
const $=id=>document.getElementById(id),SAFE=/^([\w-]+\/)?[\w.-]+\.html$/;
const sel=Object.assign({family:'all',kind:'all',section:'all',q:'',sort:'new'},Object.fromEntries(new URLSearchParams(location.hash.slice(1))));
const count=k=>pages.reduce((m,p)=>(m[p[k]]=(m[p[k]]||0)+1,m),{});
function el(tag,props,...kids){const e=document.createElement(tag);Object.assign(e,props||{});e.append(...kids);return e;}
function card(p,tag='a'){
  const c=el(tag,{className:'card'});c.style.setProperty('--c',COLORS[p.family]||COLORS.other);
  if(tag==='a'&&SAFE.test(p.path))c.href=p.path;
  const m=el('div',{className:'m'},el('span',{className:'tag',textContent:label(p.family)}),el('span',{className:'tag',textContent:p.kind}));
  if(p.date)m.append(el('span',{className:'date',textContent:p.date}));
  const copy=el('button',{className:'copy',type:'button',textContent:'copy path',title:'Copy as a starting template'});
  copy.onclick=e=>{
    e.preventDefault();
    const flash=t=>{copy.textContent=t;setTimeout(()=>copy.textContent='copy path',1200);};
    const path=document.getElementById('manifest').dataset.root+'/'+p.path;
    if(!navigator.clipboard){flash('copy failed');return;}
    navigator.clipboard.writeText(path).then(()=>flash('copied'),()=>flash('copy failed'));
  };
  c.append(el('div',{className:'t',textContent:p.title}),m,el('div',{className:'row'},el('code',{textContent:p.path}),copy));
  return c;
}
function chips(id,key){
  const host=$(id),n=count(key),keys=Object.keys(n).sort();
  if(keys.length<2){host.hidden=true;return;}
  ['all',...keys].forEach(k=>host.append(el('button',{type:'button',textContent:k==='all'?'all':k+' '+n[k],onclick:()=>{sel[key]=k;render();}},)));
  host.querySelectorAll('button').forEach((b,i)=>b.dataset.k=['all',...keys][i]);
}
function families(){
  const n=count('family'),host=$('fam');
  [['all',pages.length],...Object.entries(n).sort((a,b)=>b[1]-a[1])].forEach(([k,v])=>{
    const b=el('button',{type:'button',onclick:()=>{sel.family=k;render();}},el('span',{className:'grow',textContent:k==='all'?'All families':label(k)}),el('i',{textContent:v}));
    b.dataset.k=k;b.style.setProperty('--c',COLORS[k]||'var(--accent)');host.append(b);
  });
}
function stats(){
  const dated=pages.filter(p=>p.date).map(p=>p.date).sort();
  [['pages',pages.length],['families',Object.keys(count('family')).length],['dated editions',dated.length],['latest',dated.at(-1)||'—']]
    .forEach(([k,v])=>$('stats').append(el('div',{},el('b',{textContent:v}),k)));
  EDITIONS.forEach(f=>{const p=pages.filter(x=>x.family===f&&x.date).sort((a,b)=>b.date.localeCompare(a.date))[0];if(p)$('latest').append(card(p));});
}
function render(){
  sel.q=$('q').value.toLowerCase();sel.sort=$('sort').value;
  document.querySelectorAll('[data-k]').forEach(b=>{const key=b.closest('#fam')?'family':b.parentElement.id;b.setAttribute('aria-pressed',sel[key]===b.dataset.k);});
  const cmp={new:(a,b)=>(b.date||'').localeCompare(a.date||''),old:(a,b)=>(a.date||'9').localeCompare(b.date||'9'),az:(a,b)=>a.title.localeCompare(b.title)}[sel.sort];
  const rows=pages.filter(p=>['family','kind','section'].every(k=>sel[k]==='all'||p[k]===sel[k])&&(p.title+' '+p.path).toLowerCase().includes(sel.q))
    .sort((a,b)=>cmp(a,b)||a.path.localeCompare(b.path));
  $('list').replaceChildren(...(rows.length?rows.map(p=>el('li',{},card(p))):[el('li',{className:'empty',textContent:'No pages match.'})]));
  $('count').textContent=rows.length+' of '+pages.length+' pages';
  $('latestWrap').hidden=!!(sel.q||sel.family!=='all'||sel.kind!=='all'||sel.section!=='all');
  const h=new URLSearchParams(Object.entries(sel).filter(([k,v])=>v&&v!=='all'&&!(k==='sort'&&v==='new'))).toString();
  history.replaceState(null,'',h?'#'+h:location.pathname);
}
families();chips('kind','kind');chips('section','section');stats();
$('q').value=sel.q;$('sort').value=sel.sort;$('q').oninput=render;$('sort').onchange=render;
document.addEventListener('keydown',e=>{if(e.key==='/'&&document.activeElement!==$('q')){e.preventDefault();$('q').focus();}});
render();
</script>
</body>
</html>
